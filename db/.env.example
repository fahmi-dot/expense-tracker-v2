# Non-secret required identifiers
POSTGRES_DB=expense
POSTGRES_USER=expense_owner
POSTGRES_PORT=5432

# Set locally. Do not commit real values.
POSTGRES_PASSWORD=<set-expense_owner-password>
APP_DATABASE_PASSWORD=<set-expense_app-password>

# Backend runtime uses expense_app, never expense_owner.
DATABASE_URL=postgresql://expense_app:<set-expense_app-password>@127.0.0.1:5432/expense
